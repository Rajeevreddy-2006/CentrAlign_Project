# Autonomous AI Task Worker - Environment Configuration Template
# Copy this file to .env and provide your actual API keys. Never commit .env!

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection
MODEL_NAME=gemini-2.5-flash

# Worker Execution Settings
MAX_STEPS=25
RUNS_DIR=runs
HEADLESS_BROWSER=true

# Internal Simulated ERP / App Settings (if applicable)
ERP_PORT=8000
ERP_BASE_URL=http://localhost:8000
